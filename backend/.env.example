# === AdaptiFocus Backend — Environment Variables ===

# Database (leave empty for SQLite in local dev)
# DATABASE_URL=postgresql://user:pass@host:5432/adaptifocus

# JWT Secret (required in production; use a secret manager)
# JWT_SECRET=<at-least-32-character-random-secret>

# Google OAuth Client ID (from Google Cloud Console)
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# Environment: development or production
ENVIRONMENT=development

# Dev mode (must be 0 in production)
DEV_MODE=1
